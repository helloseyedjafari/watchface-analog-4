<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- only adb (shell holds DUMP) can call this -->
        <receiver
            android:name="com.seyedjafari.analogplus.phone.DebugBuildReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.seyedjafari.analogplus.DEBUG_BUILD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
