rules_version = '2';

// Analog Plus: each signed-in user reads and writes only users/{their uid}/**.
// Four document shapes exist; anything else is denied, including every other top-level path.
//
// Kill switch for a deleted account: users/{uid}/meta/account is a marker `{ deleted, updatedAt, schema }`. Creating or
// changing a design, the current design or the backup is allowed only while the marker exists and says `deleted == false`.
// A phone that deletes the account sets `deleted` to true first, so every other phone signed in to that account is refused
// from then on (it cannot write; it can still read and delete, which the wipe needs). The check is one extra document read
// per gated write (`exists` and `get` on the same path are one read in a request). The marker itself is not gated by itself,
// otherwise a deleted account could never be kept again.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isText(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function markerPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/meta/account;
    }

    // The account is live: its marker exists and does not say deleted.
    function accountActive(uid) {
      return exists(markerPath(uid)) && get(markerPath(uid)).data.deleted == false;
    }

    // `updatedAt` must be the server's clock: a client cannot forge last-write-wins ordering.
    function stampedNow(data) {
      return data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function validDesign(data) {
      return data.keys().hasOnly(['name', 'design', 'updatedAt', 'deleted', 'schema'])
        && data.keys().hasAll(['name', 'design', 'updatedAt', 'deleted', 'schema'])
        && isText(data.name, 1, 100)
        && data.name.trim().size() > 0
        && isText(data.design, 0, 950000)
        && data.deleted is bool
        && data.schema is int && data.schema >= 1 && data.schema <= 1000
        && stampedNow(data)
        // a live design carries its JSON; a tombstone carries none (the payload is dropped on delete)
        && (data.deleted ? data.design.size() == 0 : data.design.size() > 0);
    }

    function validCurrent(data) {
      return data.keys().hasOnly(['design', 'updatedAt', 'deviceId', 'deviceLabel', 'schema'])
        && data.keys().hasAll(['design', 'updatedAt', 'deviceId', 'deviceLabel', 'schema'])
        && isText(data.design, 1, 950000)
        && isText(data.deviceId, 1, 64)
        && isText(data.deviceLabel, 0, 80)
        && data.schema is int && data.schema >= 1 && data.schema <= 1000
        && stampedNow(data);
    }

    // The backup is always rewritten whole: createdAt is re-stamped on every write and `version` is not
    // checked against the stored one, so the owner's own client could write an older version number.
    // `writeId` is the document's version token: a random UUID the client generates per write. The client compares it
    // inside a Firestore transaction before replacing or deleting; the rules only check its shape.
    function validBackup(data) {
      return data.keys().hasOnly(['sealed', 'kdf', 'iterations', 'salt', 'iv', 'version', 'createdAt', 'keyFingerprint', 'writeId'])
        && data.keys().hasAll(['sealed', 'kdf', 'iterations', 'salt', 'iv', 'version', 'createdAt', 'keyFingerprint', 'writeId'])
        && isText(data.sealed, 1, 16384)
        && data.kdf in ['pbkdf2-hmac-sha256']
        && data.iterations is int && data.iterations >= 100000 && data.iterations <= 5000000
        && isText(data.salt, 16, 128)
        && isText(data.iv, 16, 64)
        && data.version is int && data.version >= 1 && data.version <= 1000
        && data.keyFingerprint is string && data.keyFingerprint.matches('[0-9a-f]{16}')
        && data.writeId is string && data.writeId.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function validMarker(data) {
      return data.keys().hasOnly(['deleted', 'updatedAt', 'schema'])
        && data.keys().hasAll(['deleted', 'updatedAt', 'schema'])
        && data.deleted is bool
        && data.schema is int && data.schema >= 1 && data.schema <= 1000
        && stampedNow(data);
    }

    match /users/{uid}/meta/{docId} {
      allow read, delete: if isOwner(uid);
      // a phone starting to sync creates it, live; only a deletion (or a kept deletion) changes `deleted` afterwards
      allow create: if isOwner(uid)
        && docId == 'account'
        && validMarker(request.resource.data)
        && request.resource.data.deleted == false;
      allow update: if isOwner(uid)
        && docId == 'account'
        && validMarker(request.resource.data);
    }

    match /users/{uid}/designs/{designId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && accountActive(uid)
        && designId.matches('[0-9a-f]{32}')
        && validDesign(request.resource.data);
    }

    match /users/{uid}/state/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && accountActive(uid)
        && docId == 'current'
        && validCurrent(request.resource.data);
    }

    match /users/{uid}/backup/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && accountActive(uid)
        && docId == 'signingKey'
        && validBackup(request.resource.data);
    }
  }
}
