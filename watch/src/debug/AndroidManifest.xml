<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: lets unpaired emulators be driven over adb (see DebugApplyReceiver). -->
        <!-- DUMP is held by the adb shell, not by other apps: only `adb shell am broadcast` can reach this receiver. -->
        <receiver android:name=".DebugApplyReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.seyedjafari.analogplus.DEBUG_APPLY" />
                <action android:name="com.seyedjafari.analogplus.DEBUG_ACTIVATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
